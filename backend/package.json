{
  "name": "charles-chatbot-backend",
  "version": "4.2.0",
  "description": "Backend do Chatbot Charles v4.2 - AI Agent com Cache Redis + 209 Testes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "chat": "node run-chat-local.js",
    "test": "jest --config ../jest.config.js --coverage",
    "test:watch": "jest --config ../jest.config.js --watch",
    "test:ci": "jest --config ../jest.config.js --ci --coverage --maxWorkers=2",
    "test:verbose": "jest --config ../jest.config.js --verbose",
    "guardians:check": "node scripts/check-guardians.js",
    "deploy:validate": "npm run test && npm run guardians:check",
    "docker:build": "docker build --target runtime -t charles-ai-v4.2:latest .",
    "docker:build:test": "docker build --target test -t charles-ai-v4.2:test .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f charles",
    "docker:deploy": "docker-compose -f docker-compose.yml up -d --build",
    "ci:all": "npm run test:ci && npm run guardians:check && npm audit --audit-level=high",
    "pdf:index": "node ../scripts/pdf-routine.js index",
    "pdf:ask": "node ../scripts/pdf-routine.js ask",
    "pdf:list": "node ../scripts/pdf-routine.js list"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0"
  }
}
