igin,"/_layouts/15/images/alternateBlankThumbnail.png")}function Y(a,b={streamWebPartPropertyOverrides:{}}){let c=o.Guid.newGuid().toString();return[{controlType:q.CanvasControlType.WebPartZone,webPartId:r.X6,id:c,reservedHeight:W.OT,reservedWidth:W.qI,position:{zoneIndex:1,sectionIndex:1,controlIndex:1,layoutIndex:1},webPartData:a?{id:r.X6,instanceId:c,title:"Stream",description:"Display a single video or multiple videos from a folder in OneDrive or SharePoint.",audiences:[],serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{title:""},imageSources:{},links:{serverRelativeUrl:"",wopiurl:""}},dataVersion:"1.0",properties:{sourceType:"VIDEO",file:"",isPlaceholderState:!1,query:{contentLocation:1,contentTypes:[3],documentTypes:[11],sortType:1},templateId:1,maxItemsPerPage:6,maxRowsPerPage:1,hideWebPartWhenEmpty:!1,isTitleEnabled:!1,listSortField:"Modified",layoutId:"Theater",dataProviderId:"StreamVideo",maxRowsPerPageGrid:2,maxRowsPerPageTheater:1,caml:(0,W.f0)(),...b.streamWebPartPropertyOverrides},containsDynamicDataSource:!1}:(0,W.Db)(c,b.streamWebPartPropertyOverrides)}]}let Z=JSON.parse('{"gj":"Conectividade perfeita","x":"No mundo interconectado de hoje, o trabalho remoto tornou-se um problema global. A rotina de escritório tradicional de 9 a 5 está evoluindo, dando espaço para uma maneira de trabalho mais flexível e dinâmica. Nosso site foi projetado para atender às necessidades de profissionais e organizações que adotam a revolução do trabalho remoto.","me":"Pessoas","cE":"Exibir as pessoas selecionadas e os perfis delas","zv":"Equipe de liderança","$U":"Experimente a colaboração em tempo real, promova a criatividade e mantenha a produtividade, independentemente da sua localização física.","Oi":"-Bruno Zhao, Presidente","RF":"Destaques da mensagem","wE":"Atividades de criação de equipe","Lz":"A viagem de equipe Demính foi mais do que apenas uma visita. Foi uma oportunidade de promover o trabalho em equipe, a colaboração e a parceria. Nossa recapitulação destaca as várias atividades de criação de equipe das quais participamos, como salas de escape, desafios de grupo e workshops interativos. Por meio dessas experiências, fortaleçamos nossos laços, melhoremos nossas habilidades de solução de problemas e descobrimos novos vínculos dentro de nossa equipe.","qK":"Detalhes da recapitulação fora do local","NC":"Equipe de treinamento","jy":"Workshops interativos de treinamento cruzado","QR":"Planejamento de longo prazo","jd":"Salas de fuga e outras diversões","TB":"Site do evento","$m":"Prepare-se para o êxito","L":"Viagens de integração personalizadas","lM":"Com nosso Portal de Integração de Equipe, você pode criar uma experiência de integração perfeita que deixe uma impressão positiva contínua nos novos membros da equipe. A partir do momento em que eles aceitam a oferta até o primeiro dia e depois, nossa estrutura fornece um guia estruturado e amigável por meio do processo de integração.","Is":"Líderes de treinamento","qI":"Configuração do local de trabalho","R3":"Guia de função","Kk":"Recursos de trabalho flexíveis","RO":"Treinamento interdisciplinar"}');function $(){return p.Uri.concatenate(location.origin,"/_layouts/15/images/videoEventTemplateThumbnail.jpg")}function _(){return{id:"cbe7b0a9-3504-44dd-a3a3-0e5cacd07788",title:c.TitleRegionWebpartTitle,description:c.TitleRegionWebpartDescription,dataVersion:"1.4",instanceId:"cbe7b0a9-3504-44dd-a3a3-0e5cacd07788",serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{},imageSources:{imageSource:$()},links:{}},properties:{imageSourceType:2,title:`${c.VideoEventTemplateDefaultTitleString}`,textAlignment:"Center",showPublishDate:!1,authors:void 0,showTopicHeader:!0,authorByline:void 0,layoutType:"FullWidthImage",topicHeader:`${c.VideoEventTemplateTitleHeader}`,enableGradientEffect:!0,translateX:50.028490028490026,translateY:89.28571428571429,imgHeight:1536,imgWidth:2048,hasTitleBeenCommitted:!1}}}function aa(a,b={isImageFullWidth:!0,streamWebPartPropertyOverrides:{