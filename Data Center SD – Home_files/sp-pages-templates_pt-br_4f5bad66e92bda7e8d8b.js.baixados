:{title:ak.AF},imageSources:{},links:{"items[0].sourceItem.url":"https://www.microsoft.com","items[1].sourceItem.url":"https://www.microsoft.com","items[2].sourceItem.url":"https://www.microsoft.com","items[3].sourceItem.url":"https://www.microsoft.com"},componentDependencies:{layoutComponentId:"706e33c8-af37-4e7b-9d22-6e5694d92a6f"}},dataVersion:"2.4",properties:{items:ad(),isMigrated:!0,layoutId:"FilmStrip",shouldShowThumbnail:!0,imageWidth:100,buttonLayoutOptions:{showDescription:!1,buttonTreatment:2,iconPositionType:2,textAlignmentVertical:2,textAlignmentHorizontal:2,linesOfText:2},listLayoutOptions:{showDescription:!1,showIcon:!0},waffleLayoutOptions:{iconSize:1,onlyShowThumbnail:!1},hideWebPartWhenEmpty:!0,dataProviderId:"QuickLinks",iconPicker:"onenotelogoinverse"},containsDynamicDataSource:!1},webPartId:"c70391ea-0b10-4ee9-b2b4-006d3fcad0cd",reservedWidth:1188,reservedHeight:154},{position:{layoutIndex:1,zoneIndex:8,zoneId:"73750e63-da3b-40d4-8358-48bbd9ae71a6",sectionIndex:1,sectionFactor:12,controlIndex:1},emphasis:{zoneEmphasis:0},id:"650f4856-f564-4793-96e6-acc09f022c58",controlType:3,isFromSectionTemplate:!1,addedFromPersistedData:!0,webPartData:{id:"7f718435-ee4d-431c-bdbf-9c4ff326f46e",instanceId:"650f4856-f564-4793-96e6-acc09f022c58",title:M.w0,description:M.rv,audiences:[],serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{title:ak.Xt,"persons[0].name":"Johanna Lorenz","persons[1].name":"Grady Archie","persons[0].email":"JohannaL@M365x61310646.OnMicrosoft.com","persons[1].email":"GradyA@M365x61310646.OnMicrosoft.com"},imageSources:{},links:{}},dataVersion:"1.5",properties:{layout:1,persons:[{id:"JohannaL@M365x61310646.OnMicrosoft.com",role:"Senior Engineer",aadObjectId:"a985f535-a610-403a-b4b1-d8eee7949046"},{id:"GradyA@M365x61310646.OnMicrosoft.com",role:"Designer",aadObjectId:"007a02d9-ba1a-4184-be26-82837de57560"}]},containsDynamicDataSource:!1},webPartId:"7f718435-ee4d-431c-bdbf-9c4ff326f46e",reservedWidth:1188,reservedHeight:144}],am=JSON.parse('{"tF":"Plano de fundo","kO":"Todos os anos, trabalhamos em diversas disciplinas para planejar nossas áreas de foco em investimentos de alto impacto que equilibrem inovações nas áreas de engenharia, pesquisa, design e marketing. Em seguida, treinamos nosso processo para atender a esses investimentos. Queremos que nossos processos sirvam a equipe no cumprimento de nossos compromissos com nossos clientes, nossos parceiros, o negócio e uns com os outros. Os processos de equipe devem nos ajudar a entregar resultados com energia, clareza, transparência e rigor.","rV":"Relatórios de status mensais","ZB":"Revisões mensais","q$":"Atividades e recursos anuais e trimestrais","E6":"Reunião de estratégia e slides de pontos de verificação","UO":"Objetivos e principais resultados","EL":"Roteiro e contatos das partes interessadas","Yd":"Como parte do nosso compromisso contínuo com a transparência e a responsabilidade, usamos relatórios de status mensais para manter todos atualizados e garantir que estamos todos na mesma página em nossos projetos e iniciativas.","Q":"Todos os meses, revisamos os principais resultados para cada empresa, além de compartilhar insights e progresso para atingir nossas metas. As reuniões são fóruns úteis de responsabilidade para resultados de negócios. Eles também oferecem oportunidades para aprender com os pares e ver como nós buscamos resultados.","sJ":"A cada inverno, celebramos nossas conquistas e nossa equipe com uma atualização de nossa visão de equipe para o próximo ano. Temos uma feira comercial com equipes parceiras em toda a empresa para celebrar a colaboração. A cada trimestre, nosso CVP se reúne com líderes de equipe para compartilhar uma breve atualização e ter uma discussão estratégica interativa. Assim como no restante do nosso trabalho, compartilhamos os slides da reunião de estratégia com toda a equipe. Os líderes da equipe enviam atualizações trimestrais do progresso dos pontos de verificação entre si e compartilham os slides dos pontos de verificação com todos da equipe."}'),an={imageSource:"/_LAYOUTS/IMAGES/ABSTRACT3.JPG",layoutType:"ColorBlock",title:c.ProcessTemplateTitle},ao=(a={})=>A({...an,...a}),ap=()=>[{controlType:4,id:"1212fc8d-dd6b-408a-8d5d-9f1cc787efbb",position:{controlIndex:2,sectionIndex:1,sectionFactor:12,zoneIndex:1,layoutIndex:1},addedFromPersistedData:!0,innerHTML:`<h4><span class="fontColorThemePrimary">${am.tF}</span></h4><p>${am.kO}</p>`},{position:{layoutIndex:1,zoneIndex:2,sectionIndex:1,sectionFactor:6,controlIndex:1},controlType:3,id:"bdb088b5-fdad-4be8-8a8a-b9c9e4d90491",webPartId:"d1d91016-032f-456d-98a4-721247c305e8",reservedHeight:406,reservedWidth:570,addedFromPersistedData:!0,webPartData:{id:"d1d91016-032f-456d-98a4-721247c305e8",instanceId:"bdb088b5-fdad-4be8-8a8a-b9c9e4d90491",title:M.U6,description:M.ag,audiences:[],serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{},imageSources:{imageSource:"/_LAYOUTS/IMAGES/ABSTRACT2.JPG"},links:{}},dataVersion:"1.11",properties:{imageSourceType:2,captionText:"",altText:c.ImageAltTextSpheres,linkUrl:"",overlayText:"",imgWidth:2560,imgHeight:1440,cropX:640,cropY:60,cropWidth:1280,cropHeight:1280,overlayTextStyles:{textColor:"light",isBold:!1,isItalic:!1,textBoxColor:"dark",textBoxOpacity:.54,overlayColor:"light",overlayTransparency:0},isOverlayTextVisible:!0,alignment:"Center",isAspectRatioLockedOnLoad:!0,aspectRatioOnLoad:1,fixAspectRatio:!0,advancedImageEditorData:{isAdvancedEdited:!1}},containsDynamicDataSource:!1}},{controlType:4,id:"0d98a8dc-a27c-4e00-b84d-f21041bbdce7",position:{layoutIndex:1,zoneIndex:2,sectionIndex:1,sectionFactor:6,controlIndex:2},addedFromPersistedData:!0,innerHTML:`<h4><span class="fontColorThemePrimary">${am.rV}</span></h4><p>${am.Yd}</p>`},{position:{layoutIndex:1,zoneIndex:2,sectionIndex:2,sectionFactor:6,controlIndex:1},controlType:3,id:"e594f993-ac52-4204-be3f-990b343c67e8",webPartId:"d1d91016-032f-456d-98a4-721247c305e8",reservedHeight:406,reservedWidth:570,addedFromPersistedData:!0,webPartData:{id:"d1d91016-032f-456d-98a4-721247c305e8",instanceId:"e594f993-ac52-4204-be3f-990b343c67e8",title:M.U6,description:M.ag,audiences:[],serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{},imageSources:{imageSource:"/_LAYOUTS/IMAGES/ABSTRACT5.JPG"},links:{}},dataVersion:"1.11",properties:{imageSourceType:2,captionText:"",altText:c.ImageAltTextSquares,linkUrl:"",overlayText:"",imgWidth:2560,imgHeight:1920,cropX:320,cropY:0,cropWidth:1920,cropHeight:1920,overlayTextStyles:{textColor:"light",isBold:!1,isItalic:!1,textBoxColor:"dark",textBoxOpacity:.54,overlayColor:"light",overlayTransparency:0},isOverlayTextVisible:!0,alignment:"Center",isAspectRatioLockedOnLoad:!0,aspectRatioOnLoad:1,fixAspectRatio:!0,advancedImageEditorData:{isAdvancedEdited:!1}},containsDynamicDataSource:!1}},{controlType:4,id:"8f663cb7-b293-4d3f-9441-c923d510fd74",position:{layoutIndex:1,zoneIndex:2,sectionIndex:2,sectionFactor:6,controlIndex:2},addedFromPersistedData:!0,innerHTML:`<h4><span class="fontColorThemePrimary">${am.ZB}</span></h4><p>${am.Q}</p>`},{controlType:4,id:"e4a7584b-eac1-41ae-93ba-fa3098260c60",position:{layoutIndex:1,zoneIndex:3,sectionIndex:1,sectionFactor:12,controlIndex:1},addedFromPersistedData:!0,innerHTML:`<h4><span class="fontColorThemePrimary">${am.q$}</span></h4><p>${am.sJ}</p><p>&nbsp;</p><ul><li>${am.E6}</li><li>${am.UO}</li><li>${am.EL}</li></ul>`},{controlType:0,pageSettingsSlice:{isDefaultDescription:!0,isDefaultThumbnail:!0,isSpellCheckEnabled:!0,globalRichTextStylingVersion:1,rtePageSettings:{contentVersion:5},isEmailReady:!0,webPartsPageSettings:{isTitleHeadingLevelsEnabled:!0,isLowQualityImagePlaceholderEnabled:(0,G.ym)()}}}],aq=JSON.parse('{"tF":"Sustentabilidade, responsabilidade corporativa e transformação digital","kO":"A sustentabilidade e a responsabilidade corporativa tornaram-se considerações vitais para as empresas que almejam o sucesso a longo prazo, abordando preocupações ambientais e sociais. Simultaneamente, a transformação digital fornece as ferramentas e capacidades para impulsionar e ampliar os esforços de sustentabilidade e responsabilidade através da tomada de decisões baseada em dados, comunicação transparente e maior envolvimento das partes interessadas. A integração da sustentabilidade e da responsabilidade com a transformação digital permite que as empresas operem de forma responsável, otimizem processos, melhorem as experiências dos clientes e construam organizações resilientes que prosperem em um futuro sustentável e socialmente consciente.","rV":"Sustentabilidade e CSR","ZB":"Transformação digital","q$":"Juntando tudo","AG":"[Link de âncora do Tópico A aqui]","JE":"[Link da âncora do Tópico B aqui]","E6":"Integrar tecnologias digitais","UO":"Alterar o modo como as organizações operam","EL":"Agregar valor aos clientes","PL":"A sustentabilidade e a responsabilidade social corporativa (CSR) ganharam atenção significativa no mundo dos negócios devido ao crescente reconhecimento dos desafios ambientais e sociais. Sustentabilidade refere-se à capacidade de satisfazer as necessidades presentes sem comprometer a capacidade das gerações futuras de satisfazerem as suas próprias necessidades. A CSR, por outro lado, envolve as empresas que assumem a responsabilidade pelo seu impacto na sociedade e trabalham ativamente para fazer uma diferença positiva.","hI":"A transformação digital refere-se à integração de tecnologias digitais em todos os aspectos de uma empresa, alterando fundamentalmente a forma como as organizações operam e fornecem valor para seus clientes. Com o rápido avanço da tecnologia, as empresas estão aproveitando o poder das ferramentas digitais para simplificar as operações, aprimorar a eficiência e criar modelos de negócios inovadores.","wd":"Em resumo, a combinação de sustentabilidade e CSR com transformação digital cria uma poderosa sinergia. Ela permite que as empresas adotem práticas responsáveis, atenuem os riscos e promovam mudanças positivas, aproveitando o potencial das ferramentas digitais para otimizar as operações, aprimorar as experiências do cliente e alcançar o sucesso a longo prazo em um cenário de negócios em rápida evolução. Essa abordagem integrada é fundamental para a criação de organizações resilientes e orientadas a propósitos que crescem em um futuro sustentável e socialmente ciente.","mT":"Daisy","ZU":"Phillips","kv":"Bruno","X4":"Zhao","z":"Especialista em Marketing","fg":"Coordenador de eventos"}'),ar="/_LAYOUTS/IMAGES/OFFICE.JPG",as={imageSource:"/_layouts/15/images/sleektemplateimagetile.jpg",layoutType:"NoImage",title:c.TopicTemplateTitle},at=(a={})=>A({...as,...a}),au=()=>[{controlType:4,id:"1212fc8d-dd6b-408a-8d5d-9f1cc787efbb",position:{controlIndex:1,sectionIndex:1,sectionFactor:12,zoneIndex:1,layoutIndex:1},addedFromPersistedData:!0,innerHTML:`<h3>${aq.tF}</h3><p>${aq.kO}</p><p><span class="fontColorThemePrimary">${aq.AG}</span></p><p><span class="fontColorThemePrimary">${aq.JE}</span></p>`},{position:{controlIndex:2,sectionIndex:1,sectionFactor:12,zoneIndex:1,layoutIndex:1},controlType:3,id:"fc09edf8-a2b2-4339-966d-f68aeb3d4176",webPartId:"d1d91016-032f-456d-98a4-721247c305e8",reservedHeight:818,reservedWidth:1188,addedFromPersistedData:!0,webPartData:{id:"d1d91016-032f-456d-98a4-721247c305e8",instanceId:"fc09edf8-a2b2-4339-966d-f68aeb3d4176",title:M.U6,description:M.ag,audiences:[],serverProcessedContent:{htmlStrings:{},searchablePlainTexts:{},imageSources:{imageSource:ar},links:{}},dataVersion:"1.11",properties:{imageSourceType:2,captionText:"",altText:c.ImageAltTextPeopleAtOfficeTable,linkUrl:"",overlayText:"",imgWidth:2560,imgHeight:1440,cropX:0,cropY:680,cropWidth:2560,cropHeight:720,overlayTextStyles:{textColor:"light",isBold:!1,isItalic:!1,textBoxColor:"dark",textBoxOpacity:.54,overlayColor:"light",overlayTransparency:0},isOverlayTextVisible:!0,alignment:"Center",isAspectRatioLockedOnLoad:!0,aspectRatioOnLoad:2560/720,fixAspectRatio:!0,advancedImageEditorData:{isAdvancedEdited:!1}