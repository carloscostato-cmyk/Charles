ado","j2":"Agendar comunicado","TF":"Revisar e salvar como um rascunho","wU":"Examinar e enviar","hw":"Revisar e agendar","vQ":"Examine os detalhes do anúncio antes de compartilhá-lo com seu público-alvo","G6":"Enviando anúncio","DI":"Salvando anúncio","ou":"Anúncio de agendamento","VE":"Seu comunicado foi enviado com êxito","$Y":"Seu rascunho foi salvo com êxito","z$":"Seu anúncio foi agendado com êxito","T2":"Você pode criar um link para este site.","eh":"Insira uma URL válida começando com https: ou http:","cV":"Detalhes do anúncio","XN":"Agendar um anúncio para uma data posterior","Xw":"Data e hora em que o anúncio expirará","_U":"Título","xF":"Inserir seu cargo","B2":"limite de caracteres","ry":"caracteres à esquerda","eb":"Mensagem","jV":"Inserir sua mensagem","ER":"Data e hora do término","Ss":"Audiência","X0":"Selecionar uma data","FX":"Selecione uma data até 2 semanas no futuro ou 2 semanas após a data de envio agendada.","Qy":"Audiência","vu":"Selecionar os grupos para enviar este anúncio","eW":"Mais opções","fI":"Adicionar um link","IA":"Add external link","lz":"Link","rB":"Insira um rótulo a ser usado para o link","qM":"Link que será adicionado ao anúncio","P8":"URL","VK":"Rótulo","bE":"Permitir que os usuários ignorem","e3":"Permitir que os usuários ignorem este comunicado após a exibição","J8":"Ativado","ys":"Desligado","QB":"Agendamento","LW":"Agendar para enviar mais tarde","hp":"Agendar para enviar mais tarde","Ii":"Inserir a data","M":"Inserir a hora","SB":"Descartar anúncio?","rK":"Salve este anúncio como um rascunho para manter suas alterações.","U3":"Tem certeza que deseja descartar as alterações?","eN":"Sim, descartar","gV":"Cancelar","bw":"Isso levará apenas um momento","LF":"Pode levar alguns minutos para que um novo anúncio seja exibido.","x6":"Exibir todos os comunicados","Uv":"Quando estiver pronto para enviar este comunicado, vá para a página de comunicados.","CG":"Ocorreu um problema ao enviar o comunicado. Tente novamente.","Xk":"Ocorreu um problema ao agendar o comunicado. Tente novamente.","jd":"Ocorreu um problema ao salvar o comunicado como um rascunho. Tente novamente.","GN":"Este comunicado não pode ser agendado porque a configuração de agendamento não foi habilitada para o site.","TM":"Saiba mais sobre como ativar o agendamento.","SR":"Este comunicado não pode ser {0} porque o direcionamento do público-alvo não foi habilitado para o site.","uS":"Saiba mais sobre como ativar o direcionamento de público-alvo.","gG":"Selecione um tempo no futuro que ainda não tenha passado.","JO":"A hora de término não pode ser anterior à hora programada.","DB":"Selecione um tempo no futuro que ainda não tenha passado.","gC":"O horário agendado não pode ser posterior ao horário de término.","wT":"salvo","He":"agendado","Vn":"enviado","GY":"Escolher como filtrar os destinatários desta notificação","_y":"Selecionar grupos específicos","jI":"Escolha o público-alvo inserindo grupos de segurança existentes.","u":"Filtrar por propriedade","mY":"Escolha locais, departamentos e cargos para o público-alvo de trabalho de linha de frente.","oe":"Detalhes da licença","Er":"Os comunicados são um recurso premium e exigem determinado licenciamento para que as pessoas em sua organização os exibam","H4":"Obter mais detalhes sobre licenciamento","dT":"Painel de anúncios","lD":"Os públicos que correspondem às propriedades selecionadas verão este anúncio.","ej":"Saiba mais sobre a filtragem para funcionários da linha de frente","i4":"Localização","Uh":"Departamento","Tf":"Cargo","rR":"Agendar comunicado","I6":"Permitir que os usuários ignorem o anúncio","aN":"Adicionar um link","ci":"Adicionar um rótulo para o link"}');var F=N(8999),G=N(8424);G.loadStyles(".rotateIcon{transition:transform .3s ease-in-out}.rotateIcon.expanded{transform:rotate(90deg)}.headerTextNew{flex:auto}.headerTextNew .headerTitle{font-size:20px;font-weight:600}.headerTextNew .headerDescription{font-size:14px;margin-top:5px}.headerText{flex:auto;margin-bottom: