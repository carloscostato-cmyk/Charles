# ===========================================
# Chatbot Charles v3.0 - Configuração
# State of the Art 2026
# ===========================================

# ===========================================
# PROVEDOR DE LLM (Smart Model Selection)
# ===========================================
# Escolha o provedor principal:
#   groq       - (PADRÃO) Grátis, rápido, Llama 3 70B
#   openrouter - Alternativa com vários modelos
#   gemini     - Google Gemini
#
# FASE 8: Smart Model Selection ativo automaticamente.
# O sistema classifica a complexidade da pergunta (LOW/MEDIUM/HIGH)
# e seleciona o modelo mais apropriado para otimizar custo.
LLM_PROVIDER=groq

# ===========================================
# CHAVES DE API - LLM (ROTAÇÃO DE CHAVES)
# ===========================================
# Você pode configurar múltiplas chaves separadas por vírgula para balanceamento e fallback.
# Exemplo: GROQ_API_KEYS=chave1,chave2,chave3
# Se usar apenas uma chave, pode manter o formato no singular.

# GROQ (RECOMENDADO - grátis)
# https://console.groq.com
GROQ_API_KEYS=sua_chave_groq_aqui,chave_opcional_extra_aqui

# OPENROUTER (alternativa)
# https://openrouter.ai
# OPENROUTER_API_KEYS=sua_chave_openrouter_aqui

# GEMINI (fallback + embeddings)
# https://aistudio.google.com/apikey
# GEMINI_API_KEYS=sua_chave_gemini_aqui

# OPENAI (opcional - para embeddings premium)
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sua_chave_openai_aqui

# ===========================================
# FASE 1: RAG ENTERPRISE
# ===========================================
# O RAG usa embeddings para busca semântica.
# Se GEMINI_API_KEY ou OPENAI_API_KEY estiver configurada,
# embeddings premium serão usados. Caso contrário, usa embedding local.
# RAG_COLLECTION=charles-knowledge

# ===========================================
# FASE 4: MEMÓRIA MODERNA
# ===========================================
# A memória persiste conversas e fatos do usuário em SQLite.
# MEMORY_USER_ID=default

# ===========================================
# FASE 7: OBSERVABILIDADE
# ===========================================
# O tracing registra todas as requisições para análise.
# TRACE_RETENTION_DAYS=30

# ===========================================
# CONFIGURAÇÕES DO SERVIDOR
# ===========================================
# HOST: interface de rede em que o servidor escuta
#   0.0.0.0 (PADRÃO) - Acessível de qualquer IP (rede local)
#   127.0.0.1          - Apenas localhost (acesso local)
# PORT=3000
# HOST=0.0.0.0
# Para acessar de outro PC na rede:
#   1. Mantenha HOST=0.0.0.0 (ou remova a linha)
#   2. Descubra o IP: ipconfig (Windows) / ifconfig (Linux/Mac)
#   3. No outro PC: http://SEU_IP:3000
# Ex: http://192.168.1.100:3000

# ===========================================
# SEGURANÇA - MICROSOFT ENTRA ID (AZURE AD)
# ===========================================
# OBRIGATÓRIO para produção: Tenant ID do Azure AD
# AZURE_TENANT_ID=seu-tenant-id-aqui

# OBRIGATÓRIO: Client ID da aplicação registrada no Azure AD
# AZURE_CLIENT_ID=seu-client-id-aqui

# OPCIONAL: Audience (normalmente o mesmo Client ID)
# AZURE_AUDIENCE=

# Tenant IDs autorizados (separados por vírgula)
# ALLOWED_TENANT_IDS=

# Modo de validação: strict (valida assinatura) ou permissive
# AUTH_VALIDATION_MODE=strict

# IMPORTANTE: false para produção, true apenas para desenvolvimento local
ALLOW_ANONYMOUS=true

# OPCIONAL: Requer MFA (true/false)
# REQUIRE_MFA=false

# CORS - Origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# TLS: true apenas se proxy corporativo quebrar HTTPS (risco MITM)
# ALLOW_INSECURE_TLS=false

# ===========================================
# RESUMO DAS FUNCIONALIDADES (FASES 1-8)
# ===========================================
# FASE 1: RAG Enterprise - ChromaDB/SQLite + embeddings semânticos
# FASE 2: Tool Calling - CalculateTool, SearchKnowledgeTool, CurrentDateTool, SystemStatusTool
# FASE 3: Agent Router - Roteamento inteligente (elimina pipeline fixo)
# FASE 4: Modern Memory - Short-term, Long-term, Semantic (User Facts)
# FASE 5: Streaming - SSE (Server-Sent Events) token-by-token
# FASE 6: Multimodalidade - Upload de PDF, DOCX, XLSX, TXT, MD
# FASE 7: Observabilidade - Tracing, métricas, dashboard operacional
# FASE 8: Smart Model Selection - Classificação LOW/MEDIUM/HIGH + fallback
# FASE 9: Segurança - Entra ID, CORS, rate-limit, PII, RBAC